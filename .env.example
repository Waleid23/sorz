# Copy to .env.local and fill in from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Test accounts for Playwright checks and `npm run test:rls` (create them in
# Supabase → Authentication → Users with "Auto Confirm User").
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_USER2_EMAIL=
TEST_USER2_PASSWORD=
